{
  "name": "electron-notify-manager",
  "version": "1.0.0",
  "description": "In-app toast notifications for Electron using BrowserWindow (not OS native notifications).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublish": "npm run clean && npm run build"
  },
  "files": [
    "dist/",
    "renderer/"
  ],
  "keywords": [
    "electron",
    "notification",
    "toast",
    "notify"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "electron": "^28.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "ts-jest": "^29.2.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "electron": ">=13.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/electron-notify-manager"
  },
  "bugs": {
    "url": "https://example.invalid/electron-notify-manager/issues"
  },
  "homepage": "https://example.invalid/electron-notify-manager#readme"
}
